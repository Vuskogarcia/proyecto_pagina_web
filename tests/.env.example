# Copia este archivo como .env (en esta misma carpeta) y ajusta los valores.
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-secreta
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (valores por defecto = docker-compose.yml de la raíz)
DB_ENGINE=postgres
DB_NAME=ecommerce_db
DB_USER=admin
DB_PASSWORD=adminpassword
DB_HOST=localhost
DB_PORT=5432

# Para probar sin Postgres (el test de concurrencia no funciona en SQLite):
# DB_ENGINE=sqlite
