# Copia este archivo como .env (en esta misma carpeta) y ajusta los valores.
# El .env NO se versiona (.gitignore). Nunca subas claves reales al repositorio.

# DEBUG está apagado por defecto (ADL-07). Enciéndelo solo en tu máquina.
DEBUG=True

# Obligatoria: sin ella el proyecto no arranca. Genera una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Con DEBUG=False se rechazan claves de ejemplo o de menos de 50 caracteres.
SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1
# Solo si sirves el sitio desde otro dominio u origen (ej. https://tienda.example.com):
# CSRF_TRUSTED_ORIGINS=https://tienda.example.com

# Pon HTTPS=true SOLO cuando el sitio se sirva por HTTPS: activa cookies
# seguras, redirección a HTTPS y HSTS. En local con runserver déjalo en false.
HTTPS=false

# PostgreSQL (valores del docker-compose.yml de la raíz, solo para desarrollo)
DB_ENGINE=postgres
DB_NAME=ecommerce_db
DB_USER=admin
DB_PASSWORD=adminpassword
DB_HOST=localhost
DB_PORT=5432

# Para probar sin Postgres (el test de concurrencia necesita PostgreSQL de verdad):
# DB_ENGINE=sqlite

# Límite de intentos de inicio de sesión (por usuario + IP)
# LOGIN_MAX_INTENTOS=5
# LOGIN_BLOQUEO_SEGUNDOS=900
# LOG_LEVEL=INFO
